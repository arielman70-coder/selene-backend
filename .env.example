# ---------- Supabase ----------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # NEVER expose to Lovable / any client
SUPABASE_ANON_KEY=

# ---------- Shopify ----------
SHOPIFY_STORE_DOMAIN=mystore.myshopify.com
# Supply EITHER a long-lived admin token...
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx
# ...OR client credentials, exchanged for a token at runtime via
# POST /admin/oauth/access_token (grant_type=client_credentials).
# If both are set, the static token wins.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=               # Admin > Notifications > Webhooks > signing secret
SHOPIFY_API_VERSION=2024-10
SHOPIFY_STOREFRONT_URL=https://yourbrand.co.il   # public storefront, used to build product links

# ---------- WhatsApp ----------
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
TWILIO_ACCOUNT_SID=                   # optional fallback
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---------- Email ----------
RESEND_API_KEY=re_xxxxxxxxxxxx
SES_ACCESS_KEY_ID=                    # optional fallback
SES_SECRET_ACCESS_KEY=
SES_REGION=eu-central-1

FROM_EMAIL=noreply@yourbrand.co.il
FROM_NAME=SELENE
FROM_WHATSAPP_NAME=SELENE

# ---------- Business rules ----------
ABANDONED_CART_DELAY_MINUTES=30
ABANDONED_CART_MAX_REMINDERS=2
ABANDONED_CART_DEDUP_HOURS=6
ABANDONED_CART_COUPON_PCT=10
ABANDONED_CART_COUPON_HOURS=24
ABANDONED_CART_REMINDER_GAP_HOURS=24
CASHBACK_COUPON_TTL_DAYS=7
CASHBACK_MIN_REDEEM=10
REDEEM_RATE_LIMIT_PER_HOUR=3
LOOKUP_RATE_LIMIT_PER_HOUR=20
CLUB_SESSION_MINUTES=30

UPSELL_DELAY_MINUTES=2
UPSELL_OFFER_TTL_HOURS=48
UPSELL_COUPON_PCT=15

# ---------- Runtime ----------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
API_TOKEN_SECRET=                     # signs club session tokens (any long random string)
CRON_SECRET=                          # shared secret for /jobs/* endpoints called by pg_cron
CORS_ORIGINS=https://yourbrand.co.il,https://preview.lovable.app
