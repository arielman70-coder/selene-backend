{
  "name": "selene-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Shopify + Supabase backend: abandoned cart recovery, cashback/tiers, upsell",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/index.ts\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "register-webhooks": "ts-node scripts/register-webhooks.ts",
    "list-webhooks": "ts-node scripts/register-webhooks.ts --list"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.658.0",
    "@supabase/supabase-js": "^2.45.4",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.10",
    "@types/ws": "^8.18.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "resend": "^4.0.0",
    "twilio": "^5.3.0",
    "typescript": "^5.6.2",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2"
  }
}
